# Local Postgres (dev) connection info — copy to .env and fill in real values
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agent2db
POSTGRES_USER=agent2db
POSTGRES_PASSWORD=
# App database (Agent2DB's own tables live in schema `agent2db`; the checkpointer tables too).
DATABASE_URL=postgresql://agent2db:@localhost:5433/agent2db
# Optional: a different database for Agent2DB's own state (defaults to DATABASE_URL).
AGENT2DB_APP_DSN=

# Least-privilege roles used by the Postgres MCP servers. Create them with
#   uv run --project services/agent agent2db-setup-roles --ddl --write-env
# Leave empty to fall back to DATABASE_URL (dev only: the read server still runs read-only
# transactions, and writes still need approval, but the database itself won't block writes).
AGENT2DB_RO_DSN=
AGENT2DB_RW_DSN=

# Agent backend (optional)
AGENT2DB_MODEL=
# Comma-separated models tried in order when the primary fails (rate limit, outage, bad key).
AGENT2DB_FALLBACK_MODELS=
# Embedding model for hybrid schema ranking; defaults to the first provider with a key, `off` disables.
AGENT2DB_EMBEDDING_MODEL=
AGENT2DB_MAX_STEPS=
AGENT2DB_MAX_HISTORY_CHARS=
AGENT2DB_SCHEMA_MAX_TABLES=
AGENT2DB_SCHEMA_MAX_CHARS=
# MCP tool call timeout (seconds) and where MCP child servers write their logs
AGENT2DB_TOOL_TIMEOUT=
AGENT2DB_LOG_DIR=

# LLM provider API keys — set only the providers you use
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
