# Local Postgres (dev) connection info — copy to .env and fill in real values
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agent2db
POSTGRES_USER=agent2db
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://agent2db:@localhost:5433/agent2db

# Least-privilege roles used by the Postgres MCP servers (see docs/database.md)
AGENT2DB_RO_DSN=postgresql://agent2db_ro:@localhost:5433/agent2db
AGENT2DB_RW_DSN=postgresql://agent2db_rw:@localhost:5433/agent2db

# LLM provider API keys (placeholders — fill in later)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
